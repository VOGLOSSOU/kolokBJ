# Copier en .env.local et adapter.

# Base des appels API. En dev, garder /api : Vite relaie vers Express (voir vite.config.ts).
VITE_API_URL=/api

# Adresse d'Express en local, utilisée par le proxy de dev uniquement.
API_PROXY_TARGET=http://localhost:3000

# Client ID Google Identity Services (console Google Cloud).
VITE_GOOGLE_CLIENT_ID=

# true = pas de backend : session simulée, avec une barre de dev pour changer de statut.
VITE_API_MOCK=true
